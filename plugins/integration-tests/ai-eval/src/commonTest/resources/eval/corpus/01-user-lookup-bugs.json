  "id": "01-user-lookup-bugs",
  "title": "Add user lookup by name and display name",
  "description": "Implements PROJ-12: look up users by name and render a display name that is null-safe for deleted users.\n\nNo behavior change for existing callers.",
  "sourceBranch": "feature/PROJ-12-user-lookup",
  "commits": [
    "feat(users): add findByName and displayName (PROJ-12)"
  ],
  "files": [
    {
      "path": "src/main/kotlin/users/UserRepository.kt",
      "diff": [
        "@@ -10,4 +10,13 @@ class UserRepository(",
        "     private val db: Database,",
        " ) {",
        "+    fun findByName(name: String): User? {",
        "+        val sql = \"SELECT * FROM users WHERE name = '$name'\"",
        "+        return db.queryOne(sql)",
        "+    }",
        "+",
        "+    fun displayName(id: Long): String {",
        "+        val user = db.find(id)",
        "+        return user!!.name.uppercase()",
        "+    }",
        " ",
        "     fun count(): Int = db.count()"
      ]
    }
