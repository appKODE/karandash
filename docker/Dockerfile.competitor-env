# Karandash Competitor Benchmark Environment Image
#
# Extends benchmark-env with all competitor tools pre-installed:
#   - danger-js (npm)
#   - danger-kotlin (native launcher)
#   - reviewdog (binary)
#   - hyperfine (benchmarking harness)
#
# Build:
#   docker build --platform linux/amd64 -f docker/Dockerfile.benchmark-env -t karandash/benchmark-env .
#   docker build --platform linux/amd64 -f docker/Dockerfile.competitor-env -t karandash/competitor-env \
#     --build-arg BASE_IMAGE=karandash/benchmark-env .
#
# Usage in CI:
#   image: ${CI_REGISTRY_IMAGE}/competitor-env:latest-amd64
#   needs: [build-fatjar, build-native]
#   script:
#     - bash tools/benchmarks/benchmark-competitors.sh

ARG BASE_IMAGE=karandash/benchmark-env:latest-amd64
FROM ${BASE_IMAGE}

LABEL org.opencontainers.image.title="karandash-competitor-env"
LABEL org.opencontainers.image.description="Competitor benchmark environment with danger-js, reviewdog, danger-kotlin, hyperfine"

# Node.js 20 LTS (for danger-js)
RUN set -eux; \
    find /etc/apt -type f -name '*.list' -print0 | xargs -0r sed -i 's|http://|https://|g'; \
    apt-get -o Acquire::Retries=5 -o Acquire::http::No-Cache=true -o Acquire::https::No-Cache=true update; \
    apt-get install -y --no-install-recommends \
        curl \
        ca-certificates \
        gnupg \
        git; \
    mkdir -p /etc/apt/keyrings; \
    curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key \
        | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg; \
    echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_20.x nodistro main" \
        > /etc/apt/sources.list.d/nodesource.list; \
    apt-get -o Acquire::Retries=5 -o Acquire::http::No-Cache=true -o Acquire::https::No-Cache=true update; \
    apt-get install -y --no-install-recommends nodejs; \
    rm -rf /var/lib/apt/lists/*

# danger-js
RUN npm install -g danger

# reviewdog
ENV REVIEWDOG_VERSION=v0.20.3
RUN curl -fsSL "https://github.com/reviewdog/reviewdog/releases/download/${REVIEWDOG_VERSION}/reviewdog_${REVIEWDOG_VERSION#v}_Linux_x86_64.tar.gz" \
    | tar -xz -C /usr/local/bin reviewdog \
    && chmod +x /usr/local/bin/reviewdog

# danger-kotlin (native launcher)
ENV DANGER_KOTLIN_VERSION=1.3.4
RUN curl -fsSL "https://github.com/danger/kotlin/releases/download/${DANGER_KOTLIN_VERSION}/danger-kotlin-linuxX64.tar" \
    -o /tmp/danger-kotlin.tar \
    && tar -xf /tmp/danger-kotlin.tar -C /usr/local \
    && rm /tmp/danger-kotlin.tar \
    && chmod +x /usr/local/bin/danger-kotlin

# hyperfine (precision benchmarking)
ENV HYPERFINE_VERSION=v1.18.0
RUN DPKG_ARCH="$(dpkg --print-architecture)" && \
    curl -fsSL "https://github.com/sharkdp/hyperfine/releases/download/${HYPERFINE_VERSION}/hyperfine_${HYPERFINE_VERSION#v}_${DPKG_ARCH}.deb" \
    -o /tmp/hyperfine.deb \
    && dpkg -i /tmp/hyperfine.deb \
    && rm /tmp/hyperfine.deb

# Git config for fixture repos
RUN git config --global user.email "bench@karandash.dev" && \
    git config --global user.name "Karandash Benchmark" && \
    git config --global init.defaultBranch main

WORKDIR /workspace
CMD ["bash"]
