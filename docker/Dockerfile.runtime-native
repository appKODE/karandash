# Karandash Native Runtime Image
#
# Minimal image for running Karandash native binary.
# Receives the pre-built cli.kexe - does NOT compile from source.
#
# Build (after producing the native binary via build job or karandash.sh):
#   docker build --platform linux/amd64 -f docker/Dockerfile.runtime-native \
#     --build-arg BINARY_FILE=cli/build/bin/linuxX64/releaseExecutable/cli.kexe \
#     --build-arg BRIDGE_JAR_FILE=plugins/loader/jar-bridge/build/libs/karandash-jar-bridge.jar \
#     --build-arg VERSION=1.0.0 \
#     -t karandash/runtime-native .
#
# Usage:
#   docker run --rm --platform linux/amd64 karandash/runtime-native karandash validate --help

FROM debian:bookworm-slim

ARG VERSION=0.0.0
ARG BINARY_FILE=cli/build/bin/linuxX64/releaseExecutable/cli.kexe
# The jar-bridge sits next to the binary, where JarBridgeClient.findBridgeJar looks; JAR plugins also need a
# Java 17+ the image does not ship (mount one or set KARANDASH_BRIDGE_JAR); native/JS/WASM plugins need neither.
ARG BRIDGE_JAR_FILE=plugins/loader/jar-bridge/build/libs/karandash-jar-bridge.jar

LABEL org.opencontainers.image.title="karandash-native"
LABEL org.opencontainers.image.description="Karandash MR validation tool (native Linux x64)"
LABEL org.opencontainers.image.version="${VERSION}"

RUN set -eux; \
    find /etc/apt -type f -name '*.list' -print0 | xargs -0r sed -i 's|http://|https://|g'; \
    apt-get -o Acquire::Retries=5 -o Acquire::http::No-Cache=true -o Acquire::https::No-Cache=true update; \
    apt-get install -y --no-install-recommends \
        libssl3 \
        libcurl4 \
        ca-certificates; \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY ${BINARY_FILE} /app/karandash
COPY ${BRIDGE_JAR_FILE} /app/karandash-jar-bridge.jar
RUN chmod +x /app/karandash

ENV PATH="/app:${PATH}"

RUN groupadd -r karandash && useradd -r -m -g karandash karandash
USER karandash

CMD ["karandash", "--help"]
