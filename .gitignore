.gradle/
build/
builds/
.gitlab-ci-local/

# Runtime data (statistics, AI state, caches)
.karandash/
/cache/

# Project configs are committed; cache and stats are ignored
!projects/*/.karandash/
projects/*/.karandash/cache/
projects/*/.karandash/stats/
projects/**/.karandash/cache/
projects/**/.karandash/stats/

# Project build artifacts
projects/*/build/
.idea/
*.iml
.DS_Store
local.properties
out/
*.kexe
.konan

# Temporary report files (not project documentation)
*_REPORT.md
*_SUMMARY.md
*_STATUS.md
*_BENCHMARKS.md
*_IMPLEMENTATION*.md
*_DISTRIBUTION*.md
PHASE_*.md

# Keep important markdown files
!README.md
!CHANGELOG.md
!BUILD_REQUIREMENTS.md
!CONTRIBUTING.md

# Benchmark results (generated, not committed)
benchmarks/results/

core/src/commonMain/kotlin/io/karandash/Version.kt
.env
.env.*
.gitlab-ci-local-variables.yml
*.local.kts
.kotlin/
tools/ide-extensions/vscode-extension/node_modules/
.fingerprint

# Example build artifacts
tools/examples/**/build/
tools/examples/**/build-ci/
tools/examples/**/.gradle/
tools/examples/**/.idea/
tools/examples/**/target/
tools/examples/**/*.dylib
tools/examples/**/*.so
tools/examples/**/*.dll
tools/examples/**/*.h
tools/examples/**/node_modules/
tools/examples/**/Cargo.lock

# Log files
*.log
hs_err_pid*.log
logs/

# Python (for docs build)
venv/
.venv/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
docs/venv/

# Generated by core/api/build.gradle.kts:generateVersionFile from `version` in root build.gradle.kts
core/api/src/commonMain/kotlin/io/karandash/Version.kt

# Example WASM binaries are build outputs: Gradle (:plugins:loader) and build.sh rebuild them
tools/examples/**/*.wasm
