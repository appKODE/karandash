{
    "rules": {
        "ruleConfigs": {
            "titleFormat": {
                "pattern": "^(feat|fix|docs|style|refactor|perf|test|chore|ci|build)(\\(.+\\))?:.+",
                "minLength": 10,
                "maxLength": 72
            },
            "commitMessages": {
                "pattern": "^(feat|fix|docs|style|refactor|perf|test|chore|ci|build)(\\(.+\\))?:.+",
                "maxLength": 72,
                "minLength": 10
            },
            "branchNaming": {
                "allowedPatterns": [
                    "feat/.*",
                    "fix/.*",
                    "docs/.*",
                    "refactor/.*",
                    "test/.*",
                    "chore/.*"
                ],
                "requireSourceMatch": true,
                "requireTargetMatch": false
            },
            "sizeLimits": {
                "maxFiles": 50,
                "maxLines": 1000
            },
            "draftPrevention": {
                "blockDraft": "off"
            }
        },
        "ruleMeta": {}
    },
    "platforms": null,
    "reporters": null,
    "profile": null,
    "scripts": null,
    "dangerfile": null,
    "baseline": null,
    "dryRun": false,
    "dryRunScope": null,
    "allowLocalhost": false,
    "allowPrivateNetwork": false,
    "enrichment": null,
    "enrichmentProviders": null,
    "ai": null,
    "aiReports": null,
    "aiMetrics": null,
    "autoApprove": null,
    "cache": null,
    "limits": {
        "maxFindings": 10000,
        "fetchTimeout": "10s",
        "expressions": {
            "maxLength": 1000,
            "maxNestingDepth": 50
        },
        "extends": {
            "maxEntries": 10,
            "maxDepth": 5,
            "maxChainSize": 20
        },
        "glob": {
            "maxExpansion": 10,
            "maxDirectoryDepth": 5
        },
        "regex": {
            "maxPatternLength": 500,
            "maxQuantifierNesting": 1
        },
        "patterns": {
            "maxExpansionDepth": 20
        }
    },
    "http": {
        "retry": null,
        "pagination": null,
        "responseCache": null
    },
    "patterns": {},
    "timeouts": null,
    "diagnostics": null,
    "policies": [],
    "profileOverrides": {
        "title": {
            "minLength": null,
            "maxLength": null,
            "maxSubjectLength": null
        },
        "size": {
            "maxLines": null,
            "maxCommits": null
        }
    },
    "display": {
        "git": {
            "shortShaLength": 7
        },
        "watcher": {
            "debounce": "500ms"
        },
        "console": {
            "successMark": "✓",
            "failureMark": "✗"
        }
    },
    "ruleEnrichment": null
}
