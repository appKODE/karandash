{
    "rules": {
        "ruleConfigs": {
            "titleFormat": {
                "pattern": "^(feat|fix|docs|test|refactor|chore|ci|perf|style|build)(\\(.+\\))?: .+",
                "maxLength": 72
            },
            "commitMessages": {
                "pattern": "^(feat|fix|docs|test|refactor|chore|ci|perf|style|build)(\\(.+\\))?: .+",
                "maxLength": 100
            },
            "labels": {
                "requiredLabels": [
                    "status: needs-review"
                ],
                "forbiddenLabels": [
                    "status: do-not-merge",
                    "wip"
                ]
            },
            "approval": {
                "minApprovals": 1
            },
            "codeowners": {
                "path": "CODEOWNERS",
                "requireOwnerApproval": true
            },
            "cicdStatus": {
                "requirePassed": true,
                "requiredJobs": [
                    "build",
                    "test",
                    "lint"
                ],
                "blockOnFailing": "fail"
            },
            "draftPrevention": {
                "blockDraft": "fail"
            },
            "conflict": {
                "blockOnConflicts": "fail"
            },
            "sizeLimits": {
                "maxLines": 800,
                "maxFiles": 30
            }
        },
        "ruleMeta": {
            "titleFormat": {
                "priority": 100,
                "bailOnFail": false,
                "when": null,
                "mode": "normal",
                "suggestion": "Use conventional commit format, e.g. 'feat(auth): add OAuth2 support' or 'fix: handle null response'",
                "explanation": "Conventional commits enable GitHub Actions to generate release notes and changelogs automatically",
                "concernArea": null,
                "severity": null,
                "excludePaths": []
            },
            "commitMessages": {
                "priority": 100,
                "bailOnFail": false,
                "when": null,
                "mode": "normal",
                "suggestion": "Format commits as '<type>[(scope)]: <description>', e.g. 'fix(api): resolve timeout on large responses'",
                "explanation": "Consistent commit messages improve git history and are required for semantic-release tooling",
                "concernArea": null,
                "severity": null,
                "excludePaths": []
            }
        }
    },
    "platforms": {
        "github": {
            "token": ""
        }
    },
    "reporters": {
        "console": {},
        "sarif": {
            "outputFile": "karandash-results.sarif"
        }
    },
    "profile": null,
    "scripts": null,
    "dangerfile": null,
    "baseline": null,
    "dryRun": false,
    "dryRunScope": null,
    "allowLocalhost": false,
    "allowPrivateNetwork": false,
    "enrichment": null,
    "enrichmentProviders": null,
    "ai": null,
    "aiReports": null,
    "aiMetrics": null,
    "autoApprove": null,
    "cache": null,
    "limits": {
        "maxFindings": 10000,
        "fetchTimeout": "10s",
        "expressions": {
            "maxLength": 1000,
            "maxNestingDepth": 50
        },
        "extends": {
            "maxEntries": 10,
            "maxDepth": 5,
            "maxChainSize": 20
        },
        "glob": {
            "maxExpansion": 10,
            "maxDirectoryDepth": 5
        },
        "regex": {
            "maxPatternLength": 500,
            "maxQuantifierNesting": 1
        },
        "patterns": {
            "maxExpansionDepth": 20
        }
    },
    "http": {
        "retry": null,
        "pagination": null,
        "responseCache": null
    },
    "patterns": {},
    "timeouts": null,
    "diagnostics": null,
    "policies": [],
    "profileOverrides": {
        "title": {
            "minLength": null,
            "maxLength": null,
            "maxSubjectLength": null
        },
        "size": {
            "maxLines": null,
            "maxCommits": null
        }
    },
    "display": {
        "git": {
            "shortShaLength": 7
        },
        "watcher": {
            "debounce": "500ms"
        },
        "console": {
            "successMark": "✓",
            "failureMark": "✗"
        }
    },
    "ruleEnrichment": null
}
