{
    "rules": {
        "ruleConfigs": {
            "titleFormat": {
                "pattern": "^(feat|fix|docs|test|refactor|chore|ci|perf|style|build)(\\(.+\\))?: .+",
                "maxLength": 72
            },
            "commitMessages": {
                "pattern": "^(feat|fix|docs|test|refactor|chore|ci|perf|style|build)(\\(.+\\))?: .+",
                "maxLength": 100
            },
            "approval": {
                "minApprovals": 2
            },
            "conflict": {
                "blockOnConflicts": "fail"
            },
            "sizeLimits": {
                "maxLines": 1000,
                "maxFiles": 50
            }
        },
        "ruleMeta": {
            "titleFormat": {
                "priority": 100,
                "bailOnFail": false,
                "when": null,
                "mode": "normal",
                "suggestion": "Use conventional commit format, e.g. 'feat: add S3 bucket policy' or 'fix: resolve IAM permission error'",
                "explanation": "Conventional commit prefixes enable automated changelogs and semantic versioning",
                "concernArea": null,
                "severity": null,
                "excludePaths": []
            },
            "commitMessages": {
                "priority": 100,
                "bailOnFail": false,
                "when": null,
                "mode": "normal",
                "suggestion": "Format commits as '<type>[(scope)]: <description>', e.g. 'chore(deps): update AWS SDK to v3'",
                "explanation": "Consistent commit messages improve traceability across CodePipeline and CodeBuild runs",
                "concernArea": null,
                "severity": null,
                "excludePaths": []
            }
        }
    },
    "platforms": {
        "awsCodeCommit": {
            "region": "us-east-1"
        }
    },
    "reporters": {
        "console": {}
    },
    "profile": null,
    "scripts": null,
    "dangerfile": null,
    "baseline": null,
    "dryRun": false,
    "dryRunScope": null,
    "allowLocalhost": false,
    "allowPrivateNetwork": false,
    "enrichment": null,
    "enrichmentProviders": null,
    "ai": null,
    "aiReports": null,
    "aiMetrics": null,
    "autoApprove": null,
    "cache": null,
    "limits": {
        "maxFindings": 10000,
        "fetchTimeout": "10s",
        "expressions": {
            "maxLength": 1000,
            "maxNestingDepth": 50
        },
        "extends": {
            "maxEntries": 10,
            "maxDepth": 5,
            "maxChainSize": 20
        },
        "glob": {
            "maxExpansion": 10,
            "maxDirectoryDepth": 5
        },
        "regex": {
            "maxPatternLength": 500,
            "maxQuantifierNesting": 1
        },
        "patterns": {
            "maxExpansionDepth": 20
        }
    },
    "http": {
        "retry": null,
        "pagination": null,
        "responseCache": null
    },
    "patterns": {},
    "timeouts": null,
    "diagnostics": null,
    "policies": [],
    "profileOverrides": {
        "title": {
            "minLength": null,
            "maxLength": null,
            "maxSubjectLength": null
        },
        "size": {
            "maxLines": null,
            "maxCommits": null
        }
    },
    "display": {
        "git": {
            "shortShaLength": 7
        },
        "watcher": {
            "debounce": "500ms"
        },
        "console": {
            "successMark": "✓",
            "failureMark": "✗"
        }
    },
    "ruleEnrichment": null
}
