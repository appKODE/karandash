pipeline {
    agent any

    tools {
        jdk 'jdk-17'
    }

    triggers {
        // Run on pull request events
        pullRequest()
    }

    stages {
        stage('Download Karandash') {
            steps {
                sh '''
                    wget https://github.com/appKODE/karandash/releases/latest/download/karandash.jar
                '''
            }
        }

        stage('Validate MR') {
            steps {
                sh '''
                    java -jar karandash.jar validate
                '''
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: '*.sarif', allowEmptyArchive: true
        }
    }
}
